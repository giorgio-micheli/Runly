# Auto detect text files and perform LF normalization in the repository.
# Git will convert them to the OS-native line ending on checkout (CRLF on
# Windows, LF on macOS/Linux) and back to LF when committing.
* text=auto eol=lf

# Sources — force LF explicitly regardless of OS
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows batch scripts need CRLF
*.bat text eol=crlf

# Binary files — do not touch, no diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.so binary
*.jar binary
*.ttf binary
*.otf binary